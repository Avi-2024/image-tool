# Preview default. Before public launch set the actual HTTPS origin (no path).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicitly enable only on the public production build, then rebuild.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: Google Search Console HTML verification token (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Reserved placement only. No ad network has been integrated.
NEXT_PUBLIC_ADS_ENABLED=false
# Optional, enabled only on indexable production builds after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
